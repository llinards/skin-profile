<header
  class="relative container mx-auto"
  x-data="{ showContactModal: null }"
  x-on:open-contact-modal.window="showContactModal = 'contact'; document.body.style.overflow = 'hidden'"
>
  <div class="flex justify-center absolute z-3 w-full" x-data="handleMobileMenu()" x-cloak>
    <nav class="mx-auto px-4 w-full" role="navigation" aria-label="Main navigation">
      {% if template.name == 'index'
        or template.name == 'collection'
        or page.metafields.custom.navigation_style == 'light'
      %}
        {% render 'menu', highlighted_vendors: section.settings.menu_highlighted_vendors %}
      {% else %}
        {% render 'menu', invert_class: 'invert', highlighted_vendors: section.settings.menu_highlighted_vendors %}
      {% endif %}
    </nav>
  </div>

  <!-- Contact Modal -->
  <div x-show="showContactModal === 'contact'" style="display: none;">
    {% render 'menu-contact-modal' %}
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    },
    {
      "type": "text",
      "id": "menu_highlighted_vendors",
      "label": "Izceltie zīmoli",
      "info": "Tiks attēloti treknrakstā apakšizvēlnē Zīmoli. Vairākus zīmolus atdali ar komatu. Nosaukumam precīzi jāsakrīt ar produkta zīmolu (vendor)."
    }
  ]
}
{% endschema %}
