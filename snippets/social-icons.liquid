{%- liquid
  assign whatsapp_digits = whatsapp_number | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
-%}
<div class="hidden md:flex justify-end items-center mt-12 z-10">
  <div
    id="social-icons"
    class="flex flex-col items-center md:fixed md:top-1/2 md:right-8 md:-translate-y-1/2 space-y-4 fill-white z-10 bg-(--color-brand-primary)/30 px-2 py-4 rounded-full"
  >
    {% if phone_number != blank %}
      <a class="block" aria-label="{{ 'general.accessibility.call_us' | t }}" href="tel:{{ phone_number | strip | replace: ' ', '' }}">
        {% render 'icon-phone' %}
      </a>
    {% endif %}

    {% if whatsapp_digits != blank %}
      <a
        class="block"
        aria-label="{{ 'general.accessibility.whatsapp' | t }}"
        href="https://wa.me/{{ whatsapp_digits }}"
        target="_blank"
        rel="noopener noreferrer"
      >
        {% render 'icon-whatsapp' %}
      </a>
    {% endif %}

    {% if email_address != blank %}
      <a class="block" aria-label="{{ 'general.accessibility.email_us' | t }}" href="mailto:{{ email_address | strip }}">
        {% render 'icon-mail' %}
      </a>
    {% endif %}

    {% if facebook_url != blank %}
      <a class="block" aria-label="{{ 'general.accessibility.visit_facebook' | t }}" href="{{ facebook_url }}" target="_blank" rel="noopener noreferrer">
        {% render 'icon-facebook' %}
      </a>
    {% endif %}

    {% if instagram_url != blank %}
      <a class="block" aria-label="{{ 'general.accessibility.visit_instagram' | t }}" href="{{ instagram_url }}" target="_blank" rel="noopener noreferrer">
        {% render 'icon-instagram' %}
      </a>
    {% endif %}

    {% if booking_url != blank %}
      <a class="block" aria-label="{{ 'general.accessibility.book_online' | t }}" href="{{ booking_url }}">
        {% render 'icon-booking' %}
      </a>
    {% endif %}
  </div>
</div>
