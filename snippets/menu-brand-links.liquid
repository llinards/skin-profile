{%- comment -%}
  Renders one <li> per product vendor, linking to all products filtered by that vendor.
  Used as the submenu of the "Zīmoli" menu item (see dropdown-menu-link.liquid).

  Accepts:
  - link_class: {String} Classes for each <a>
{%- endcomment -%}
{%- assign vendors = shop.vendors | sort_natural -%}
{%- for vendor in vendors -%}
  {%- if vendor != blank -%}
    <li>
      <a
        href="{{ routes.all_products_collection_url }}?filter.p.vendor={{ vendor | url_param_escape }}#products"
        class="{{ link_class }}"
      >
        {{ vendor }}
      </a>
    </li>
  {%- endif -%}
{%- endfor -%}
